---
import Layout from '../layouts/Layout.astro';
import { PreflightChecker } from '../components/PreflightChecker';

const commodities = [
  { slug: 'cattle', name: 'Cattle', icon: '🐄' },
  { slug: 'cocoa', name: 'Cocoa', icon: '🍫' },
  { slug: 'coffee', name: 'Coffee', icon: '☕' },
  { slug: 'palm-oil', name: 'Palm Oil', icon: '🌴' },
  { slug: 'rubber', name: 'Rubber', icon: '🪵' },
  { slug: 'soy', name: 'Soy', icon: '🌱' },
  { slug: 'timber', name: 'Timber', icon: '🌲' },
];
---

<Layout title="GeoHeal EUDR GeoJSON Pre-Flight Checker">
  <div class="space-y-8">
    <!-- Hero / Introduction -->
    <div class="rounded-2xl border border-slate-800/80 bg-gradient-to-b from-slate-900/90 to-slate-900/40 p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          EU Deforestation Regulation (EUDR) Ready
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
          GeoJSON Spatial Integrity &amp; Compliance Checker
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Verify agricultural plot geometries before submission to the EU Information System (TRACES NT).
          Catch coordinate inversions, non-WGS84 projections, self-intersections, ring winding errors,
          and polygon area thresholds directly in your browser.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div class="p-3.5 rounded-lg border border-slate-800 bg-slate-950/60">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">CRS Validation</div>
            <div class="text-sm font-medium text-slate-200 mt-1">EPSG:4326 (WGS84 Lon/Lat)</div>
          </div>
          <div class="p-3.5 rounded-lg border border-slate-800 bg-slate-950/60">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Geometry Types</div>
            <div class="text-sm font-medium text-slate-200 mt-1">Point (&lt;0.5 ha) &bull; Polygon (&ge;0.5 ha)</div>
          </div>
          <div class="p-3.5 rounded-lg border border-slate-800 bg-slate-950/60">
            <div class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Security</div>
            <div class="text-sm font-medium text-slate-200 mt-1">100% Client-Side Processing</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Commodity Quick Navigation -->
    <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-4">
      <div class="flex items-center justify-between mb-3 px-1">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
          Targeted Commodity Validators (EUDR Annex I)
        </span>
        <span class="text-xs text-slate-500">TRACES NT Optimized</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2">
        {commodities.map((comm) => (
          <a
            href={`/${comm.slug}-eudr-polygon-fix`}
            class="flex items-center gap-2 p-2.5 rounded-lg border border-slate-800 bg-slate-950/60 hover:border-emerald-500/50 hover:bg-slate-900 text-slate-300 hover:text-white transition group"
          >
            <span class="text-base group-hover:scale-110 transition-transform">{comm.icon}</span>
            <span class="text-xs font-medium">{comm.name}</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Pre-Flight Checker React Component -->
    <PreflightChecker client:load />
  </div>
</Layout>
